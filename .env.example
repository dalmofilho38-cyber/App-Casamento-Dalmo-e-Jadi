# GEMINI_API_KEY: Required for Gemini AI API calls if server AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Server-Side Pix Webhook Integration (NEVER expose in frontend)
# Secret used to authenticate incoming webhook notifications from your Pix provider (HMAC-SHA256 or Bearer token).
PIX_WEBHOOK_SECRET=""

# Optional Firebase Admin Service Account JSON (stringified) for server-side webhook payment confirmation.
# When omitted, webhooks validate signatures and return setup instructions without modifying Firestore.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Optional Server-Side Product Photo Search APIs (NEVER expose in frontend or VITE_* vars)
# Wikimedia Commons & Openverse work automatically without keys. Configure any optional key below to expand search results:
PEXELS_API_KEY=""
UNSPLASH_ACCESS_KEY=""
PIXABAY_API_KEY=""
BRAVE_SEARCH_API_KEY=""
SERPAPI_API_KEY=""

